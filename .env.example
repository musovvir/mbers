# Temporary public origin used for canonical, hreflang, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://mberslab.com

# Inbox that receives the contact form.
CONTACT_TO_EMAIL=hello@example.com

# SMTP settings. The form sends mail only when these are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
